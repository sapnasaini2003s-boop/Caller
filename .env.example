# Copy to .env and fill in. Never commit .env.

PORT=3100

# Any long random string. Signs session cookies — changing it logs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

# ── Infobip ───────────────────────────────────────────────────────────────
# Portal → Developer Tools → API Keys
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=

# WhatsApp sender, E.164 digits, no "+". Already live on the account.
WA_SENDER=918050002580

# ── Calling ───────────────────────────────────────────────────────────────
# manual  — caller's own phone dials (tel: link). Works today, no KYC needed.
# infobip — Infobip Voice bridges the call. Needs Voice activation + KYC.
TELEPHONY_PROVIDER=manual

# The number schools see. Required when TELEPHONY_PROVIDER=infobip.
VOICE_CALLER_ID=

# ── Webhooks ──────────────────────────────────────────────────────────────
# Must match the custom header configured in the Infobip portal.
WEBHOOK_SECRET=change-me-too
